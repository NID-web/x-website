# Server-only. No trailing slash, no /api — routes are /public/... at the root.
# The local CMS owns :3000, which is also `next dev`/`next start`'s default —
# run the front end on another port (`next start -p 4180`) while pointing here.
CMS_API_URL=https://nidapi.smartdiner.co
# true = a CMS failure fails the build (for CI later). Default: warn and fall back.
CMS_REQUIRED=false
