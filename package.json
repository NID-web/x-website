{
  "name": "scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/lint-tokens.mjs",
    "generate:tokens": "python3 design/generate.py && cp design/tokens/themes.css src/styles/themes.css && cp design/tokens/font-manifest.json src/lib/font-manifest.json",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:tokens": "next build && node scripts/verify-tokens.mjs",
    "verify:fonts": "next build && node scripts/verify-fonts.mjs",
    "verify:design": "python3 design/verify.py",
    "screenshot": "next build && node scripts/screenshot.mjs",
    "generate:motifs": "python3 scripts/generate-motifs.py",
    "generate:patterns": "python3 scripts/generate-patterns.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
