# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# env files, but keep the example
!.env.example

# Figma Make export — the 22 PNG masters only.
# They are ~29MB of already-compressed data, so git cannot shrink them and once
# committed they stay in history forever, even after deletion. They are NOT
# needed to run or demo the site: public/home/ already holds the same
# photography, web-sized (~1.8MB) — verified image-by-image against these
# masters. Keep them on disk for reference; re-export from Figma if lost.
# Everything else in design/reference IS committed (the design code gzips to
# 60K and scripts/generate-patterns.py reads it).
/design/reference/home-figma-make/src/imports/01NidHomeLanding/*.png
